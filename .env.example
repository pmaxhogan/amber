# Amber configuration. Copy to .env and fill in. .env is gitignored; this repo
# is public, so never commit real values.
#
# Only deployment fundamentals live here. Everything else (clone mode, sync
# interval, paranoid mode, concurrency) is a database setting managed in the UI.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the HTTP server listens on. Default 8080.
PORT=8080

# Interface to bind. Default 0.0.0.0. Ignored (forced to 127.0.0.1) whenever
# INSECURE_ALLOW_PUBLIC_ACCESS is on.
HOST=0.0.0.0

# Root of the data volume. Amber creates these three underneath it at boot:
#   $DATA_DIR/backups   the git backups themselves
#   $DATA_DIR/state     amber.db and other durable state
#   $DATA_DIR/logs      rotated pino log files
DATA_DIR=/data

# Each derived directory can be overridden independently, for example to keep
# backups on a large pool and state on an SSD.
#BACKUPS_DIR=/mnt/big/amber-backups
#STATE_DIR=/data/state
#LOGS_DIR=/data/logs

# fatal | error | warn | info | debug | trace | silent. Default info.
LOG_LEVEL=info

# Public origin, used to build the clone URLs shown in the UI. No trailing
# slash. Set this to the hostname you actually serve Amber on.
PUBLIC_ORIGIN=https://amber.example.com

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# AES-256-GCM key for stored account credentials. Exactly 64 hex characters.
# Generate with: openssl rand -hex 32
# Losing this makes every stored account secret unrecoverable.
AMBER_SECRET_KEY=

# ---------------------------------------------------------------------------
# Authentication (Cloudflare Access)
# ---------------------------------------------------------------------------
# Amber refuses to start unless either all three of these are set or
# INSECURE_ALLOW_PUBLIC_ACCESS=1.

# Your Access team domain, without the scheme.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# The Application Audience (AUD) tag of the Access application.
CF_ACCESS_AUD=

# Comma separated allow list, matched case-insensitively against the email
# claim in the Access JWT.
CF_ACCESS_ALLOWED_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Escape hatch
# ---------------------------------------------------------------------------
# Set to 1 to run with NO authentication. Amber then binds 127.0.0.1 only,
# whatever HOST says, logs a warning banner every 10 minutes, and shows a
# permanent red banner in the UI. For local development only. Because the bind
# is loopback inside the container, a published Docker port will not reach it:
# probe with `docker compose exec amber curl http://127.0.0.1:8080/healthz`.
#INSECURE_ALLOW_PUBLIC_ACCESS=1
