# Amber configuration. Copy to .env and fill in. .env is gitignored; this repo
# is public, so never commit real values.
#
# Only deployment fundamentals live here. Everything else (clone mode, sync
# interval, paranoid mode, concurrency) is a database setting managed in the UI.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the HTTP server listens on. Default 8080.
PORT=8080

# Interface to bind. Default 0.0.0.0. Ignored (forced to 127.0.0.1) whenever
# INSECURE_ALLOW_PUBLIC_ACCESS is on.
HOST=0.0.0.0

# Root of the data volume. Amber creates these three underneath it at boot:
#   $DATA_DIR/backups   the git backups themselves
#   $DATA_DIR/state     amber.db and other durable state
#   $DATA_DIR/logs      rotated pino log files
DATA_DIR=/data

# Each derived directory can be overridden independently, for example to keep
# backups on a large pool and state on an SSD.
#BACKUPS_DIR=/mnt/big/amber-backups
#STATE_DIR=/data/state
#LOGS_DIR=/data/logs

# fatal | error | warn | info | debug | trace | silent. Default info.
LOG_LEVEL=info

# Public origin, used to build the clone URLs shown in the UI. No trailing
# slash. Set this to the hostname you actually serve Amber on.
PUBLIC_ORIGIN=https://amber.example.com

# Peers whose X-Forwarded-For Amber believes (one hop), comma separated
# addresses or CIDRs. Default loopback only (127.0.0.0/8,::1). Set it to where
# your reverse proxy connects FROM, for example the docker network cloudflared
# shares with Amber (172.18.0.0/16). Any other peer's X-Forwarded-For is
# ignored, so no client can choose the address the git login throttle sees.
#TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# AES-256-GCM key for stored account credentials. Exactly 64 hex characters.
# Generate with: openssl rand -hex 32
# Losing this makes every stored account secret unrecoverable.
AMBER_SECRET_KEY=

# ---------------------------------------------------------------------------
# Authentication (Cloudflare Access)
# ---------------------------------------------------------------------------
# Amber refuses to start unless CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD and
# AMBER_ADMIN_EMAIL are all set, or INSECURE_ALLOW_PUBLIC_ACCESS=1.

# Your Access team domain, without the scheme.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# The Application Audience (AUD) tag of the Access application.
CF_ACCESS_AUD=

# The one admin. Holds every permission, is never capped, and is accepted on
# any valid Access token whatever policy admitted it, so editing the users
# policy or a Cloudflare API outage can never lock the admin out. It cannot be
# changed from the UI or the API.
AMBER_ADMIN_EMAIL=

# LEGACY, replaced by AMBER_ADMIN_EMAIL. When AMBER_ADMIN_EMAIL is unset, the
# FIRST entry here becomes the admin (with a deprecation warning at startup)
# and every other entry is ignored. Remove it once AMBER_ADMIN_EMAIL is set.
#CF_ACCESS_ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Users (Cloudflare Access policy)
# ---------------------------------------------------------------------------
# Everyone besides the admin is a user exactly while their email is an
# explicit "email" include rule of ONE reusable Access policy. Amber reads that
# policy every 5 minutes. Other include rule types (domains, groups, everyone)
# cannot be enumerated and are ignored.
#
# Set all three or none. Without them Amber is admin-only and every other
# identity is refused. The token needs exactly one permission:
# "Access: Apps and Policies Read". It is never logged or returned by the API.
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ACCESS_POLICY_ID=

# ---------------------------------------------------------------------------
# Escape hatch
# ---------------------------------------------------------------------------
# Set to 1 to run with NO authentication. Amber then binds 127.0.0.1 only,
# whatever HOST says, logs a warning banner every 10 minutes, and shows a
# permanent red banner in the UI. For local development only. Because the bind
# is loopback inside the container, a published Docker port will not reach it:
# probe with `docker compose exec amber curl http://127.0.0.1:8080/healthz`.
#INSECURE_ALLOW_PUBLIC_ACCESS=1

# Insecure mode only, ignored otherwise: a comma separated stand-in for the
# Access policy. A request carrying the header X-Amber-Insecure-User with one
# of these addresses acts as that user instead of the admin. For tests and
# local development; it can only ever lower a request's privilege.
#INSECURE_USER_EMAILS=
